# Supabase 접속 정보 (프론트엔드용)
#
# 이 파일을 `.env`로 복사해서 쓴다.  cp .env.example .env
#
# EXPO_PUBLIC_ 접두어가 붙은 값은 번들에 그대로 인라인되어 앱을 뜯으면 누구나 볼 수 있다.
# 아래 두 값은 원래 공개용(publishable)이라 괜찮다 — 실제 보호는 Postgres RLS가 한다.
# service_role / secret 키는 절대 EXPO_PUBLIC_ 로 넣지 않는다.
#
# .env는 반드시 Expo 프로젝트 루트(= client/)에 둔다. 리포 루트에 두면 로드되지 않는다.

EXPO_PUBLIC_SUPABASE_URL=https://hjocgdlowqlfmgwcrkkt.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_1nC9Jj6aY6nGrT7dSOED-A_ZIj8rQ-j
